-+create or replace function private.messages_before_update()
-+returns trigger
-+language plpgsql
-+security definer
-+set search_path = ''
-+as $$
-+begin
-+  if old.read_at is null and new.read_at is not null then
-+    new.read_at := now();
-+  end if;
-+  return new;
-+end;
-+$$;
